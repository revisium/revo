{
  "name": "@revisium/revo",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone distribution and composition entrypoint for Revo",
  "homepage": "https://github.com/revisium/revo#readme",
  "license": "MIT",
  "author": "Anton Kashirov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revisium/revo.git"
  },
  "bin": {
    "revo": "dist/bin/revo.js"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "exports": {
    "./configuration": "./dist/configuration/index.js",
    "./layout": "./dist/layout.js",
    "./postgres": "./dist/postgres/index.js",
    "./processes": "./dist/processes/index.js",
    "./startup-progress": "./dist/startup-progress/index.js",
    "./release-metadata": "./dist/release-metadata.js"
  },
  "scripts": {
    "build": "tsc -b --clean tsconfig.build.json && tsc -p tsconfig.build.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives .",
    "sonar:issues:local": "bash scripts/sonar-issues-local.sh",
    "test": "pnpm build && vitest run",
    "test:cov": "pnpm build && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:cov"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@revisium/revo-admin": "0.0.0",
    "@revisium/revo-core": "0.0.0",
    "koffi": "3.2.1",
    "nest-commander": "3.21.0",
    "pg": "8.22.0",
    "pg-connection-string": "2.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.15.47",
    "@types/node": "26.1.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.10",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.10.0-beta.17",
    "@embedded-postgres/darwin-x64": "17.10.0-beta.17",
    "@embedded-postgres/linux-arm64": "17.10.0-beta.17",
    "@embedded-postgres/linux-x64": "17.10.0-beta.17"
  },
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "packageManager": "pnpm@12.4.1"
}
