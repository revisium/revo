#!/bin/sh
set -eu
umask 077

revo_root=${REVO_INSTALL_ROOT:-"${HOME}/.local/share/revo"}
revo_channel=
revo_system=$(uname -s)
revo_machine=$(uname -m)
case "$revo_system/$revo_machine" in
  Darwin/arm64) revo_identity=darwin/arm64/tar.gz ;;
  Darwin/x86_64) revo_identity=darwin/x64/tar.gz ;;
  Linux/aarch64) revo_identity=linux/arm64/tar.xz ;;
  Linux/x86_64) revo_identity=linux/x64/tar.xz ;;
  *) exit 1 ;;
esac
case "$revo_identity" in
@@REVO_POSIX_BOOTSTRAP_TABLE@@
  *) exit 1 ;;
esac

revo_target=$revo_platform-$revo_arch
revo_v3=0
if [ -n "${revo_channel:-}" ]; then
  revo_v3=1
  revo_channel_root=$revo_root/$revo_channel
  revo_parent=$revo_channel_root/node/$revo_version
else
  revo_channel_root=$revo_root
  revo_parent=$revo_root/$revo_version
fi
revo_final=$revo_parent/$revo_target
if [ "$revo_v3" -eq 1 ]; then
  revo_lock=$revo_channel_root/.install.lock
else
  revo_lock=$revo_parent/.$revo_target.install.lock
fi
revo_lock_marker=
revo_lock_token=
revo_lock_acquired=0
revo_signal_status=
revo_signal_name=
revo_signal_escalated=0
revo_active_pid=
revo_active_group=
revo_active_watchdog=
revo_cleanup_safe=1
revo_runtime_stage=
revo_signal_code() {
  case "$1" in
    HUP) printf '%s\n' 129 ;;
    INT) printf '%s\n' 130 ;;
    TERM) printf '%s\n' 143 ;;
  esac
}
revo_signal_active() {
  revo_signal=$1
  if [ "$revo_signal_escalated" -eq 1 ]; then
    if [ -n "$revo_active_group" ]; then
      kill -0 "-$revo_active_group" 2>/dev/null && kill -KILL "-$revo_active_group" 2>/dev/null || :
    fi
    if [ -n "$revo_active_pid" ]; then
      kill -0 "$revo_active_pid" 2>/dev/null && kill -KILL "$revo_active_pid" 2>/dev/null || :
    fi
    if [ -n "$revo_active_watchdog" ]; then
      kill -0 "$revo_active_watchdog" 2>/dev/null && kill -TERM "$revo_active_watchdog" 2>/dev/null || :
    fi
    return 0
  fi
  if [ -n "$revo_active_pid" ]; then
    kill -0 "$revo_active_pid" 2>/dev/null && kill -"$revo_signal" "$revo_active_pid" 2>/dev/null || :
  fi
  if [ -n "$revo_active_group" ]; then
    kill -0 "-$revo_active_group" 2>/dev/null && kill -"$revo_signal" "-$revo_active_group" 2>/dev/null || :
  fi
  if [ -n "$revo_active_watchdog" ]; then
    revo_watchdog_signal=$revo_signal
    [ "$revo_watchdog_signal" = INT ] && revo_watchdog_signal=TERM
    kill -0 "$revo_active_watchdog" 2>/dev/null && kill -"$revo_watchdog_signal" "$revo_active_watchdog" 2>/dev/null || :
  fi
}
revo_external_signal() {
  revo_received=$1
  if [ -z "$revo_signal_status" ]; then
    revo_signal_name=$revo_received
    revo_signal_status=$(revo_signal_code "$revo_received")
  else
    revo_signal_escalated=1
  fi
  revo_signal_active "$revo_received"
}
trap 'revo_external_signal HUP' HUP
trap 'revo_external_signal INT' INT
trap 'revo_external_signal TERM' TERM

revo_run_bounded() {
  revo_limit=$1
  shift
  [ -z "$revo_signal_status" ] || return "$revo_signal_status"
  revo_cleanup_safe=0
  revo_active_group=
  if command -v setsid >/dev/null 2>&1; then
    setsid "$@" </dev/null &
    revo_active_group=$!
  else
    "$@" </dev/null &
  fi
  revo_active_pid=$!
  (
    revo_sleep=
    revo_watchdog_send() {
      revo_watchdog_received=$1
      kill -"$revo_watchdog_received" "$revo_active_pid" 2>/dev/null || :
      [ -z "$revo_active_group" ] || kill -"$revo_watchdog_received" "-$revo_active_group" 2>/dev/null || :
    }
    revo_watchdog_signal() {
      revo_watchdog_received=$1
      trap ':' HUP INT TERM
      [ -z "$revo_sleep" ] || kill "$revo_sleep" 2>/dev/null || :
      [ -z "$revo_sleep" ] || wait "$revo_sleep" 2>/dev/null || :
      kill -0 "$revo_active_pid" 2>/dev/null || exit 0
      revo_watchdog_send "$revo_watchdog_received"
      sleep "$revo_grace" &
      revo_sleep=$!
      wait "$revo_sleep" 2>/dev/null || :
      kill -KILL "$revo_active_pid" 2>/dev/null || :
      exit 0
    }
    trap 'revo_watchdog_signal HUP' HUP
    trap 'revo_watchdog_signal INT' INT
    trap 'revo_watchdog_signal TERM' TERM
    sleep "$revo_limit" &
    revo_sleep=$!
    wait "$revo_sleep" || exit 0
    revo_watchdog_send TERM
    sleep "$revo_grace" &
    revo_sleep=$!
    wait "$revo_sleep" || :
    revo_watchdog_send KILL
  ) &
  revo_active_watchdog=$!
  [ -z "$revo_signal_status" ] || revo_signal_active "$revo_signal_name"
  set +e
  revo_status=0
  while :; do
    wait "$revo_active_pid"
    revo_status=$?
    kill -0 "$revo_active_pid" 2>/dev/null
    revo_alive=$?
    [ "$revo_alive" -eq 0 ] || break
    [ -n "$revo_signal_status" ] || break
  done
  kill -TERM "$revo_active_watchdog" 2>/dev/null || :
  wait "$revo_active_watchdog" 2>/dev/null || :
  revo_active_pid=
  revo_active_group=
  revo_active_watchdog=
  revo_cleanup_safe=1
  set -e
  [ -z "$revo_signal_status" ] || return "$revo_signal_status"
  return "$revo_status"
}

revo_stage=
revo_probe_temp=
revo_cleanup() {
  revo_cleanup_status=0
  if [ -n "$revo_probe_temp" ]; then
    rm -f "$revo_probe_temp" || revo_cleanup_status=1
  fi
  if [ -n "$revo_stage" ] && [ "$revo_cleanup_safe" -eq 1 ]; then
    rm -rf "$revo_stage" || revo_cleanup_status=1
  fi
  if [ -n "$revo_runtime_stage" ] && [ "$revo_cleanup_safe" -eq 1 ]; then
    rm -rf "$revo_runtime_stage" || revo_cleanup_status=1
  fi
  if [ "$revo_lock_acquired" -eq 1 ] && [ "$revo_cleanup_safe" -eq 1 ]; then
    if [ ! -d "$revo_lock" ] || [ -L "$revo_lock" ] ||
      [ ! -f "$revo_lock_marker" ] || [ -L "$revo_lock_marker" ] ||
      [ "$(cat "$revo_lock_marker" 2>/dev/null)" != "$revo_lock_token" ]; then
      revo_cleanup_status=1
    elif ! rm -f "$revo_lock_marker" || [ -e "$revo_lock_marker" ] || [ -L "$revo_lock_marker" ]; then
      revo_cleanup_status=1
    elif ! rmdir "$revo_lock"; then
      revo_cleanup_status=1
    else
      revo_lock_acquired=0
    fi
  fi
  if [ -n "$revo_signal_status" ]; then
    trap - EXIT
    exit "$revo_signal_status"
  fi
  if [ "$revo_cleanup_status" -ne 0 ]; then
    trap - EXIT
    exit 1
  fi
  return 0
}
trap revo_cleanup EXIT
revo_fail() {
  [ -z "$revo_signal_status" ] || exit "$revo_signal_status"
  exit 1
}

revo_write_runtime() {
  revo_data_file=$revo_stage/bootstrap.json
  revo_payload_file=$revo_stage/payload.mjs
  cat >"$revo_data_file" <<'REVO_NODE_BOOTSTRAP_DATA'
@@REVO_NODE_BOOTSTRAP_DATA@@
REVO_NODE_BOOTSTRAP_DATA
  cat >"$revo_payload_file" <<'REVO_NODE_BOOTSTRAP_PAYLOAD'
@@REVO_NODE_BOOTSTRAP_PAYLOAD@@
REVO_NODE_BOOTSTRAP_PAYLOAD
  chmod 600 "$revo_data_file" "$revo_payload_file"
}

revo_run_staged_bounded() {
  set +e
  revo_run_bounded "$@"
  revo_status=$?
  set -e
  return "$revo_status"
}

mkdir -p -m 700 "$revo_parent" "$revo_channel_root"
if ! mkdir -m 700 "$revo_lock"; then
  exit 1
fi
revo_lock_acquired=1
revo_lock_marker=$(mktemp "$revo_lock/.owner.XXXXXX") || revo_fail
revo_lock_token=$revo_lock_marker
printf '%s\n' "$revo_lock_token" >"$revo_lock_marker" || revo_fail

if [ -e "$revo_final" ] || [ -L "$revo_final" ]; then
  [ -d "$revo_final" ] && [ ! -L "$revo_final" ] || exit 1
  [ -f "$revo_final/install-receipt.json" ] && [ ! -L "$revo_final/install-receipt.json" ] || exit 1
  [ "$(LC_ALL=C ls -ld "$revo_final/install-receipt.json" | cut -c 1-10)" = '-rw-------' ] || exit 1
  [ "$(cat "$revo_final/install-receipt.json")" = "$revo_expected_receipt" ] || exit 1
  revo_probe_temp=$revo_parent/.revo-probe.$$
  revo_run_bounded "$revo_probe_timeout" "$revo_final/bin/node" --version >"$revo_probe_temp" || revo_fail
  revo_found=$(cat "$revo_probe_temp") || revo_fail
  rm -f "$revo_probe_temp"
  revo_probe_temp=
  if [ "$revo_v3" -eq 1 ]; then
    revo_stage=$(mktemp -d "$revo_channel_root/.runtime.XXXXXX")
    chmod 700 "$revo_stage"
    revo_scratch=$revo_stage/scratch
    mkdir -m 700 "$revo_scratch"
    revo_write_runtime
    REVO_INSTALL_MODE=pnpm REVO_INSTALL_ROOT=$revo_channel_root \
      REVO_PRIVATE_NODE_ROOT=$revo_final REVO_INSTALL_SCRATCH=$revo_scratch \
      REVO_NODE_TARGET=$revo_target REVO_NODE_ARCHIVE_SHA256=$revo_sha256 \
      REVO_PLATFORM=$revo_platform REVO_ARCH=$revo_arch \
      REVO_RECEIPT_PATH=$revo_final/install-receipt.json \
      revo_run_staged_bounded "$revo_payload_timeout" "$revo_final/bin/node" \
      "$revo_payload_file" "$revo_data_file" || revo_fail
    rm -rf "$revo_stage"
    revo_stage=
  fi
  [ "$revo_found" = "v$revo_version" ] || exit 1
  exit 0
fi

revo_stage=$(mktemp -d "$revo_parent/$revo_target.stage.XXXXXX")
chmod 700 "$revo_stage"
revo_archive=$revo_stage/node-archive
revo_probe_file=$revo_stage/node-version
revo_receipt=$revo_stage/install-receipt.json
revo_write_runtime

if command -v curl >/dev/null 2>&1; then
  revo_run_staged_bounded "$revo_download_timeout" curl --fail --silent --show-error --output "$revo_archive" "$revo_url" || revo_fail
elif command -v wget >/dev/null 2>&1; then
  revo_run_staged_bounded "$revo_download_timeout" wget --max-redirect=0 -q -O "$revo_archive" "$revo_url" || revo_fail
else
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  revo_digest=$(sha256sum "$revo_archive") || exit 1
else
  revo_digest=$(shasum -a 256 "$revo_archive") || exit 1
fi
revo_actual=$(printf '%s\n' "$revo_digest" | awk '{print $1}') || exit 1
[ "$revo_actual" = "$revo_sha256" ] || exit 1

case "$revo_format" in
  tar.gz) tar -xzf "$revo_archive" -C "$revo_stage" --strip-components=1 ;;
  tar.xz) tar -xJf "$revo_archive" -C "$revo_stage" --strip-components=1 ;;
  *) exit 1 ;;
esac
revo_node=$revo_stage/bin/node
revo_run_staged_bounded "$revo_probe_timeout" "$revo_node" --version >"$revo_probe_file" || revo_fail
[ "$(cat "$revo_probe_file")" = "v$revo_version" ] || exit 1
if [ "$revo_v3" -eq 1 ] && [ "${revo_package_enabled:-0}" -eq 1 ]; then
  REVO_INSTALL_MODE= REVO_NODE_TARGET=$revo_target REVO_NODE_ARCHIVE_SHA256=$revo_sha256 REVO_RECEIPT_PATH=$revo_receipt \
    revo_run_staged_bounded "$revo_payload_timeout" "$revo_node" "$revo_payload_file" \
    "$revo_data_file" || revo_fail
  [ -f "$revo_receipt" ] && [ ! -L "$revo_receipt" ] || revo_fail
  rm -f "$revo_archive" "$revo_probe_file"
  [ ! -e "$revo_final" ] && [ ! -L "$revo_final" ] || revo_fail
  mv "$revo_stage" "$revo_final" || revo_fail
  revo_stage=
  revo_runtime_stage=$(mktemp -d "$revo_channel_root/.package-runtime.XXXXXX")
  chmod 700 "$revo_runtime_stage"
  mv "$revo_final/bootstrap.json" "$revo_runtime_stage/bootstrap.json"
  mv "$revo_final/payload.mjs" "$revo_runtime_stage/payload.mjs"
  revo_scratch=$revo_runtime_stage/scratch
  mkdir -m 700 "$revo_scratch"
  REVO_INSTALL_MODE=pnpm REVO_INSTALL_ROOT=$revo_channel_root \
    REVO_PRIVATE_NODE_ROOT=$revo_final REVO_INSTALL_SCRATCH=$revo_scratch \
    REVO_NODE_TARGET=$revo_target REVO_NODE_ARCHIVE_SHA256=$revo_sha256 \
    REVO_PLATFORM=$revo_platform REVO_ARCH=$revo_arch \
    REVO_RECEIPT_PATH=$revo_final/install-receipt.json \
    revo_run_staged_bounded "$revo_payload_timeout" "$revo_final/bin/node" \
    "$revo_runtime_stage/payload.mjs" "$revo_runtime_stage/bootstrap.json" || revo_fail
  rm -rf "$revo_runtime_stage"
  revo_runtime_stage=
  exit 0
elif [ "$revo_v3" -eq 1 ]; then
  revo_scratch=$revo_stage/scratch
  mkdir -m 700 "$revo_scratch"
  REVO_INSTALL_MODE=pnpm REVO_INSTALL_ROOT=$revo_channel_root \
    REVO_PRIVATE_NODE_ROOT=$revo_stage REVO_INSTALL_SCRATCH=$revo_scratch \
    REVO_NODE_TARGET=$revo_target REVO_NODE_ARCHIVE_SHA256=$revo_sha256 \
    REVO_PLATFORM=$revo_platform REVO_ARCH=$revo_arch \
    REVO_RECEIPT_PATH=$revo_receipt \
    revo_run_staged_bounded "$revo_payload_timeout" "$revo_node" "$revo_payload_file" \
    "$revo_data_file" || revo_fail
else
  REVO_NODE_TARGET=$revo_target REVO_NODE_ARCHIVE_SHA256=$revo_sha256 REVO_RECEIPT_PATH=$revo_receipt \
    revo_run_staged_bounded "$revo_payload_timeout" "$revo_node" "$revo_payload_file" \
    "$revo_data_file" || revo_fail
fi
[ -f "$revo_receipt" ] && [ ! -L "$revo_receipt" ] || exit 1
rm -f "$revo_archive" "$revo_data_file" "$revo_payload_file" "$revo_probe_file"
[ "$revo_v3" -eq 1 ] && rm -rf "$revo_scratch"
[ ! -e "$revo_final" ] && [ ! -L "$revo_final" ] || revo_fail
mv "$revo_stage" "$revo_final"
revo_stage=
